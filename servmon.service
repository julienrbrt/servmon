[Unit]
Description=ServMon - KISS Server Monitoring with Email Alerts
Documentation=https://github.com/julienrbrt/servmon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Path to servmon binary (adjust if installed elsewhere)
ExecStart=/usr/local/bin/servmon --config /etc/servmon/config.yaml

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=servmon

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Allow reading system information
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/

# Allow writing to specific paths if needed
# ReadWritePaths=/var/log/servmon

# Process limits
LimitNOFILE=65536
LimitNPROC=512

# Environment
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
